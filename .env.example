# ============================================================
# TEAM LEGENDS BANK (TLB) LOS — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# --- Supabase (PostgreSQL Database) ---
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...YOUR_SERVICE_ROLE_KEY...

# --- Firebase Authentication ---
# Get Project ID from: https://console.firebase.google.com/project/YOUR_PROJECT/settings/general
FIREBASE_PROJECT_ID=your-firebase-project-id

# Get service account JSON from: Firebase Console → Settings → Service Accounts → Generate new private key
# Paste the entire JSON as a single-line string (minified)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# For local dev only (alternative to FIREBASE_SERVICE_ACCOUNT_JSON):
# Download the JSON file and place it here:
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# --- Firebase Client SDK (for frontend — these are safe to expose) ---
# Get from: Firebase Console → Project Settings → Your apps → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abc123

# --- Admin Credentials (backend auth fallback) ---
ADMIN_SECRET_TOKEN=TLB-SECURE-TOKEN-UNDERWRITER-2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_password_here

# --- CIBIL / Experian Credit Bureau API ---
# Requires commercial license from TransUnion CIBIL or Experian India
# Without this key, the system uses its internal scoring engine
CIBIL_API_KEY=your_commercial_cibil_api_key_here
CIBIL_API_URL=https://api.cibil.com/v2

# --- Optional: Port for local dev ---
PORT=8080
